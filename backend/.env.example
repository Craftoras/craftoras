# Backend Server Port (Defaults to 5000, fallback to 5001 if port is in use)
PORT=5000

# MongoDB Connection URI
DB_URL=mongodb://127.0.0.1:27017/ec

# JWT Secret for Session & Authentication Tokens
SECRET=your_jwt_secret_key_here

# Cloudinary Credentials (for product and profile image uploads)
cloud_name=your_cloudinary_cloud_name
api_key=your_cloudinary_api_key
api_secret=your_cloudinary_api_secret

# Stripe Secret Key (for card payments)
STRIPE_KEY=sk_test_your_stripe_secret_key

# Client Origins for CORS
CLIENT_URL=http://localhost:3000
